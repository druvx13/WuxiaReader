<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is for the root, rewrite to public/
    RewriteRule ^$ public/ [L]

    # If the request is not for public/, rewrite it to public/
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>
